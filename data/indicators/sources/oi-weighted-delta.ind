language(1)
indicator("OI-Weighted Delta Pro", id = "pro.oi-weighted-delta", sourceable = true, optional_trades = true, max_bars_back = 512, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "OI-Weighted Delta Pro")
format(precision = "base_ticker_min_qty", scale = "fit_visible_include_zero")
sensitivity = input.float(10.0, "Sensitivity", min = 0.0, max = 1000.0)
max_weight = input.float(2.0, "Maximum weight", min = 1.0, max = 100.0)
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, select(chart.close >= chart.open, chart.volume, -chart.volume))
previous = open_interest[1]
change = select(previous > 0.0, (open_interest - previous) / previous, 0.0)
weight = math.min(max_weight, math.max(0.0, 1.0 + change * sensitivity))
value = delta * weight
rising = value >= 0.0
plot(rising, id = "rising", layer = false, overlay = false)
plot(value, id = "value", title = "OI-Weighted Delta", style = "histogram", color_slot = "positive", style_by = "rising", true_color_slot = "positive", false_color_slot = "negative", overlay = false)
style("positive", title = "Positive", role = "success")
style("negative", title = "Negative", role = "danger")
