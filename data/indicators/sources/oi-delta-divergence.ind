language(1)
indicator("OI-Delta Divergence Pro", id = "pro.oi-delta-divergence", sourceable = true, max_bars_back = 512, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "OI-Delta Divergence Pro")
format(precision = "fixed_step:0.01")
lookback = input.int(20, "Lookback", min = 2, max = 65535)
rsi_period = input.int(14, "RSI period", min = 2, max = 65535)
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
cvd = ta.cum(delta)
cvd_rsi = ta.rsi(cvd, rsi_period)
oi_rsi = ta.rsi(open_interest, rsi_period)
prior_low = ta.lowest(chart.low[1], lookback)
prior_high = ta.highest(chart.high[1], lookback)
prior_cvd_low = ta.lowest(cvd_rsi[1], lookback)
prior_cvd_high = ta.highest(cvd_rsi[1], lookback)
prior_oi_low = ta.lowest(oi_rsi[1], lookback)
prior_oi_high = ta.highest(oi_rsi[1], lookback)
bullish = chart.low < prior_low && cvd_rsi > prior_cvd_low && oi_rsi > prior_oi_low
bearish = chart.high > prior_high && cvd_rsi < prior_cvd_high && oi_rsi < prior_oi_high
plot(cvd_rsi, id = "value", title = "CVD RSI", color_slot = "cvd", overlay = false)
plot(oi_rsi, id = "oi_rsi", title = "OI RSI", color_slot = "oi", overlay = false)
plot(bullish, id = "bullish", overlay = false, layer = false)
plot(bearish, id = "bearish", overlay = false, layer = false)
style("cvd", title = "CVD RSI")
style("oi", title = "OI RSI", role = "warning")
style("bullish", title = "Bullish", role = "success")
style("bearish", title = "Bearish", role = "danger")
