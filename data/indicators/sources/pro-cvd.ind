language(1)
indicator("CVD Pro", id = "pro.pro-cvd", sourceable = true, max_bars_back = 2)
format(precision = "base_ticker_min_qty", axis_labels = "abbreviated")
candles = input.bool(false, "Candles")
line_color = input.color(color.rgb(110, 161, 184), "Line color")
up_color = input.color(color.rgb(89, 173, 128), "Up color")
down_color = input.color(color.rgb(194, 102, 107), "Down color")
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
value = ta.cum(delta)
opening = value - delta
plot(select(candles, na, value), id = "value", title = "CVD", color_slot = "main", color = line_color, width = 1.5)
plotcandle(select(candles, opening, na), math.max(opening, value), math.min(opening, value), value, id = "candles", color_slot = "main", color = select(delta >= 0.0, up_color, down_color))
style("main", title = "CVD")
