language(1)
indicator("Liquidation Pressure Index", id = "pro.liquidation-pressure", sourceable = true, max_bars_back = 2, bases = ["time"])
format(precision = "fixed_step:0.01", scale = "fit_visible_include_zero")
lookback = input.int(20, "Lookback", min = 2, max = 65535)
oi_drop_threshold = input.float(2.0, "OI drop threshold (%)", min = 0.01, max = 100.0)
delta_zscore = input.float(2.0, "Delta Z-score", min = 0.0, max = 100.0)
positive_color = input.color(color.rgb(89, 173, 128), "Positive")
negative_color = input.color(color.rgb(194, 102, 107), "Negative")
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
absolute_delta = math.abs(delta)
mean = ta.sma(absolute_delta[1], lookback)
deviation = ta.stdev(absolute_delta[1], lookback)
oi_change_pct = (open_interest / math.max(open_interest[1], 0.000000001) - 1.0) * 100.0
direction = select(delta > 0.0 && chart.close > chart.close[1], 1.0, select(delta < 0.0 && chart.close < chart.close[1], -1.0, 0.0))
score = direction * math.min(500.0, math.max(0.0, -oi_change_pct) * math.abs(delta) / math.max(mean, 0.000000001) * 100.0)
triggered = oi_change_pct <= -oi_drop_threshold && absolute_delta >= mean + delta_zscore * deviation && direction != 0.0
estimated = select(triggered, math.abs(open_interest - open_interest[1]), 0.0)
plot(score, id = "value", title = "Pressure", style = "histogram", color_slot = "main", color = select(score >= 0.0, positive_color, negative_color))
plot(estimated, id = "estimated", title = "Estimated liquidations", layer = false)
plot(triggered, id = "triggered")
style("main", title = "Pressure")
