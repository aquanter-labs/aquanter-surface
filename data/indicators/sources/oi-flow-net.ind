language(1)
indicator("OI Flow Net Pro", id = "pro.oi-flow-net", sourceable = true, optional_trades = true, max_bars_back = 11, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "OI Flow Net Pro")
format(precision = "fixed_step:0.01", scale = "fit_visible_include_zero")
basis_length = input.int(10, "Basis length", min = 2, max = 65535)
burst_sensitivity = input.int(3, "Burst sensitivity", min = 1, max = 5)
show_price_line = input.bool(false, "Show price line")
static_color = input.bool(false, "Static color")

fn relative(source) {
    average = ta.sma(source, basis_length)
    spread = select(math.abs(average) > 0.000000001, (source / average - 1.0) * 100.0, na)
    high = ta.pivothigh(spread, 5, 5)
    low = ta.pivotlow(spread, 5, 5)
    var highs = array.new()
    var lows = array.new()
    if !na(high) && high > 0.0 {
        next = array.new()
        for index = select(array.size(highs) > 19, array.size(highs) - 19, 0) to array.size(highs) - 1 {
            next := array.push(next, array.get(highs, index))
        }
        highs := array.push(next, high)
    } else if !na(low) && low < 0.0 {
        next = array.new()
        for index = select(array.size(lows) > 19, array.size(lows) - 19, 0) to array.size(lows) - 1 {
            next := array.push(next, array.get(lows, index))
        }
        lows := array.push(next, low)
    }
    samples = select(spread >= 0.0, highs, lows)
    total = 0.0
    for sample in samples {
        total := total + sample
    }
    mean = select(array.size(samples) > 0, total / array.size(samples), na)
    return select(math.abs(mean) > 0.000000001, select(spread >= 0.0, spread / mean, -(spread / mean)), na)
}
relative_oi = relative(open_interest)
relative_price = relative(chart.close)
gain = 1.0 + burst_sensitivity * 0.1
position = 0.7 + burst_sensitivity * 0.1
burst = (relative_oi > relative_oi[1] * gain && relative_oi > position) || (relative_oi < relative_oi[1] * gain && relative_oi < -position)
inflow = relative_oi >= 0.0
price_up = relative_price >= 0.0
strong = static_color || math.abs(relative_oi) >= 0.5
plot(relative_oi, id = "value", title = "Relative OI", layer = false, overlay = false)
plot(strong, id = "strong", layer = false, overlay = false)
plot(select(inflow && price_up, relative_oi, na), id = "buy_inflow", title = "Buy inflow", style = "histogram", display = "none", style_by = "strong", true_color_slot = "buy_inflow", false_color_slot = "buy_inflow_weak", overlay = false)
plot(select(inflow && !price_up, relative_oi, na), id = "sell_inflow", title = "Sell inflow", style = "histogram", display = "none", style_by = "strong", true_color_slot = "sell_inflow", false_color_slot = "sell_inflow_weak", overlay = false)
plot(select(!inflow && !price_up, relative_oi, na), id = "buy_outflow", title = "Buy outflow", style = "histogram", display = "none", style_by = "strong", true_color_slot = "buy_outflow", false_color_slot = "buy_outflow_weak", overlay = false)
plot(select(!inflow && price_up, relative_oi, na), id = "sell_outflow", title = "Sell outflow", style = "histogram", display = "none", style_by = "strong", true_color_slot = "sell_outflow", false_color_slot = "sell_outflow_weak", overlay = false)
plot(select(burst, relative_oi, na), id = "burst_marker", title = "Burst", mark = "point", display = "none", color_slot = "burst", overlay = false)
plot(select(show_price_line, relative_price, na), id = "price", title = "Relative price", color_slot = "price", overlay = false)
plot(burst, id = "burst", overlay = false, layer = false)
plot(1.0, id = "band_1", layer = false, overlay = false)
plot(2.0, id = "band_2", layer = false, overlay = false)
plot(3.0, id = "band_3", layer = false, overlay = false)
plot(-1.0, id = "band_n1", layer = false, overlay = false)
plot(-2.0, id = "band_n2", layer = false, overlay = false)
plot(-3.0, id = "band_n3", layer = false, overlay = false)
style("band", title = "Band", shade = "faint")
style("extreme_band", title = "Extreme band", shade = "soft")
fill(upper = "band_2", lower = "band_1", color_slot = "band", opacity = 0.12)
fill(upper = "band_3", lower = "band_2", color_slot = "extreme_band", opacity = 0.16)
fill(upper = "band_n1", lower = "band_n2", color_slot = "band", opacity = 0.12)
fill(upper = "band_n2", lower = "band_n3", color_slot = "extreme_band", opacity = 0.16)
readout(title = "Relative OI", source = "value", color_slot = "burst")
style("buy_inflow", title = "Buy inflow", role = "success")
style("buy_inflow_weak", title = "Buy inflow (weak)", role = "success", shade = "soft")
style("sell_inflow", title = "Sell inflow", role = "danger")
style("sell_inflow_weak", title = "Sell inflow (weak)", role = "danger", shade = "soft")
style("buy_outflow", title = "Buy outflow", role = "primary")
style("buy_outflow_weak", title = "Buy outflow (weak)", role = "primary", shade = "soft")
style("sell_outflow", title = "Sell outflow", role = "warning")
style("sell_outflow_weak", title = "Sell outflow (weak)", role = "warning", shade = "soft")
style("burst", title = "Burst")
style("price", title = "Price", role = "secondary")
