language(1)
indicator("Order Flow Bias Pro", id = "pro.order-flow-bias", sourceable = true, optional_trades = true, max_bars_back = 50, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "Order Flow Bias Pro")
format(precision = "fixed_step:0.01", scale = "fit_visible_include_zero")
lookback = input.int(20, "Lookback", min = 2, max = 100)
signal_threshold = input.float(25.0, "Signal threshold", min = 5.0, max = 100.0)
absorption_delta = input.float(0.55, "Absorption delta", min = 0.1, max = 0.95)
max_price_response = input.float(0.45, "Max price response", min = 0.05, max = 1.0)
delta = select(chart.directional_volume_available, chart.buy_qty - chart.sell_qty, na)
average_delta = ta.sma(math.abs(delta), lookback)
norm = select(average_delta > 0.0, math.max(-1.0, math.min(1.0, delta / average_delta)), 0.0)
range = math.max(chart.high - chart.low, 0.000000001)
response = math.max(-1.0, math.min(1.0, (chart.close - chart.open) / range))
strength = math.max(0.0, math.min(1.0, (math.abs(norm) - absorption_delta) / math.max(0.000000001, 1.0 - absorption_delta)))
sign = select(norm > 0.0, 1.0, select(norm < 0.0, -1.0, 0.0))
same_way = select(norm * response < 0.0, 0.0, 1.0)
failure = select(same_way == 0.0, 1.0, math.max(0.0, math.min(1.0, (max_price_response - math.abs(response)) / math.max(max_price_response, 0.000000001))))
absorption = select(strength == 0.0, 0.0, -sign * strength * failure * 35.0)
average_range = math.max(ta.sma(chart.high - chart.low, lookback), 0.000000001)
price_change = math.max(-1.0, math.min(1.0, (chart.close - chart.close[lookback]) / (average_range * lookback)))
cumulative = ta.cum(delta)
window = cumulative - cumulative[lookback + 1]
cvd_norm = math.max(-1.0, math.min(1.0, window / math.max(average_delta * (lookback + 1.0), 0.000000001)))
divergence = select(price_change * cvd_norm < 0.0, cvd_norm * 30.0, 0.0)
score = math.max(-100.0, math.min(100.0, absorption + divergence))
rising = score >= 0.0
plot(rising, id = "rising", layer = false, overlay = false)
plot(score, id = "value", title = "Bias", style = "histogram", overlay = false, color_slot = "positive", style_by = "rising", true_color_slot = "positive", false_color_slot = "negative")
style("positive", title = "Positive", role = "success")
style("negative", title = "Negative", role = "danger")
