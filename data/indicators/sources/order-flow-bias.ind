language(1)
indicator("Order Flow Bias Pro", id = "pro.order-flow-bias", sourceable = true, max_bars_back = 128, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "Order Flow Bias Pro")
format(precision = "fixed_step:0.01", scale = "fit_visible_include_zero")
preset = input.string("Conservative", "Preset", options = ["Conservative", "Balanced", "Aggressive", "Custom"])
lookback = input.int(20, "Lookback", min = 2, max = 100)
signal_threshold = input.float(35.0, "Signal threshold", min = 5.0, max = 100.0)
absorption_delta = input.float(0.75, "Absorption delta", min = 0.1, max = 0.95)
max_price_response = input.float(0.35, "Max price response", min = 0.05, max = 1.0)
imbalance_ratio = input.float(3.0, "Imbalance ratio", min = 1.1, max = 10.0)
epsilon = 0.0000000000000002220446049250313
directional = chart.directional_volume_available
delta = select(directional, chart.buy_qty - chart.sell_qty, 0.0)
delta_size_average = ta.sma(math.abs(delta), lookback)
average_delta = delta_size_average[1]
range = math.max(chart.high - chart.low, epsilon)
norm = math.max(-1.0, math.min(1.0, delta / average_delta))
response = math.max(-1.0, math.min(1.0, (chart.close - chart.open) / range))
strength = math.max(0.0, math.min(1.0, (math.abs(norm) - absorption_delta) / (1.0 - absorption_delta)))
opposed = select(norm > 0.0, response < 0.0, response >= 0.0)
failure = select(opposed, 1.0, math.max(0.0, math.min(1.0, (max_price_response - math.abs(response)) / max_price_response)))
absorption = select(strength == 0.0, 0.0, select(norm > 0.0, -1.0, 1.0) * strength * failure * 35.0)
range_average = ta.sma(chart.high - chart.low, lookback)
average_range = range_average[1]
price_change = math.max(-1.0, math.min(1.0, (chart.close - chart.close[lookback]) / (math.max(average_range, epsilon) * lookback)))
cumulative = ta.cum(delta)
window_delta = cumulative - nz(cumulative[lookback + 1], 0.0)
cvd = math.max(-1.0, math.min(1.0, window_delta / (average_delta * (lookback + 1.0))))
divergence = select(price_change * cvd < 0.0, cvd * 30.0, 0.0)
poc = chart.trade.poc
poc_rejection = select(na(poc), 0.0, math.max(-1.0, math.min(1.0, (chart.close - poc) / range)) * 20.0)
imbalance = math.max(-1.0, math.min(1.0, nz(footprint.imbalance(imbalance_ratio), 0.0))) * 15.0
valid = directional && !na(average_delta) && average_delta > epsilon
score = select(valid, math.max(-100.0, math.min(100.0, absorption + divergence + poc_rejection + imbalance)), na)
previous = score[1]
signal = barstate.isconfirmed && !na(previous) && math.abs(previous) >= signal_threshold
hit = signal && select(previous > 0.0, chart.close > chart.close[1], chart.close <= chart.close[1])
total = ta.cum(select(signal, 1.0, 0.0))
wins = ta.cum(select(hit, 1.0, 0.0))
win_rate = select(total > 0.0, wins / total * 100.0, na)
rising = score >= 0.0
plot(rising, id = "rising", layer = false, overlay = false)
plot(score, id = "value", title = "Bias", style = "histogram", overlay = false, color_slot = "positive", style_by = "rising", true_color_slot = "positive", false_color_slot = "negative")
plot(select(valid, signal_threshold, na), id = "upper", title = "Bullish threshold", color_slot = "guide", overlay = false)
plot(select(valid, -signal_threshold, na), id = "lower", title = "Bearish threshold", color_slot = "guide", overlay = false)
plot(select(valid, absorption, na), id = "absorption", title = "Absorption", layer = false, overlay = false)
plot(select(valid, divergence, na), id = "divergence", title = "CVD divergence", layer = false, overlay = false)
plot(select(valid, poc_rejection, na), id = "poc_rejection", title = "POC rejection", layer = false, overlay = false)
plot(select(valid, imbalance, na), id = "imbalance", title = "Imbalance", layer = false, overlay = false)
plot(win_rate, id = "win_rate", title = "Win rate %", layer = false, overlay = false)
readout(title = "Abs", source = "absorption", color_slot = "guide")
readout(title = "Div", source = "divergence", color_slot = "guide")
readout(title = "POC", source = "poc_rejection", color_slot = "guide")
readout(title = "Imb", source = "imbalance", color_slot = "guide")
readout(title = "Win %", source = "win_rate", color_slot = "guide")
style("positive", title = "Positive", role = "success")
style("negative", title = "Negative", role = "danger")
style("guide", title = "Guides", role = "neutral", shade = "soft")
