language(1)
indicator("EMA Pro", id = "pro.ema", sourceable = true, max_bars_back = 1)
display(view = "plot", attachment = "overlay", layer_name = "EMA")
format(precision = "base_ticker_min_tick")
period = input.int(20, "Period", min = 1, max = 65535)
source = input.source(chart.close, "Source")
value = ta.ema(source, period)
plot(value, id = "value", title = "EMA", precision = "instrument", color_slot = "main", pane = "main")
style("main", title = "EMA")
mark(title = "Line", source = "value", kind = "line", color_slot = "main")
