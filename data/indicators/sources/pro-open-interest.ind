language(1)
indicator("Open Interest Pro", id = "pro.pro-open-interest", sourceable = true, max_bars_back = 2, bases = ["time"])
display(view = "plot", attachment = "panel", layer_name = "Open Interest Pro")
format(precision = "base_ticker_min_qty", axis_labels = "abbreviated")
candles = input.bool(false, "Candles")
value = open_interest
opening = select(na(open_interest[1]), open_interest, open_interest[1])
up = value >= opening
plot(select(candles, na, value), id = "value", title = "Open Interest", color_slot = "main", overlay = false)
plotcandle(select(candles && up, opening, na), math.max(opening, value), math.min(opening, value), value, id = "up_candles", color_slot = "up", overlay = false)
plotcandle(select(candles && !up, opening, na), math.max(opening, value), math.min(opening, value), value, id = "down_candles", color_slot = "down", overlay = false)
style("main", title = "Line")
style("up", title = "Up candles", role = "success")
style("down", title = "Down candles", role = "danger")
