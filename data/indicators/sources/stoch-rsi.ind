language(1)
indicator("Stoch RSI Pro", id = "pro.stoch-rsi", sourceable = true, max_bars_back = 2)
display(view = "plot", attachment = "panel", layer_name = "Stoch RSI Pro")
format(precision = "fixed_step:0.01")
rsi_length = input.int(14, "RSI length", min = 2, max = 65535)
stochastic_length = input.int(14, "Stochastic length", min = 1, max = 65535)
k_smoothing = input.int(3, "K smoothing", min = 1, max = 65535)
d_smoothing = input.int(3, "D smoothing", min = 1, max = 65535)
rsi = ta.rsi(chart.close, rsi_length)
lowest = ta.lowest(rsi, stochastic_length)
highest = ta.highest(rsi, stochastic_length)
raw = select(highest > lowest, 100.0 * (rsi - lowest) / (highest - lowest), 0.0)
k = ta.sma(raw, k_smoothing)
d = ta.sma(k, d_smoothing)
plot(k, id = "value", title = "K", color_slot = "k", overlay = false)
plot(d, id = "d", title = "D", color_slot = "d", overlay = false)
style("k", title = "K")
style("d", title = "D", role = "warning")
